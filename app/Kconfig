mainmenu "Application Configuration"

menuconfig LED_SUBSYSTEM
	bool "LED Subsystem"
	default y

if LED_SUBSYSTEM

choice BLINK_SLEEP_TIME_CHOICE
	prompt "LED blink sleep time"
	default BLINK_SLEEP_TIME_1S
	help
	  Select LED blink period.

config BLINK_SLEEP_TIME_250MS
	bool "250ms"

config BLINK_SLEEP_TIME_500MS
	bool "500ms"

config BLINK_SLEEP_TIME_1S
	bool "1s (medium)"

config BLINK_SLEEP_TIME_2S
	bool "2s"

endchoice

# Task 3: Add a new Kconfig option for BLINK_SLEEP_TIME_MS
config BLINK_SLEEP_TIME_MS
	int
	default 250 if BLINK_SLEEP_TIME_250MS
	default 500 if BLINK_SLEEP_TIME_500MS
	default 1000 if BLINK_SLEEP_TIME_1S
	default 2000 if BLINK_SLEEP_TIME_2S

	# Task 4: Add a new Kconfig option for APP_HEARTBEAT_PERIOD_MS
config APP_HEARTBEAT_PERIOD_MS
	int "APP heartbeat period (ms)"
	default 500
	range 100 2000
	help
	  Heartbeat period for the application. This is the time between each heartbeat message sent by the application.

menuconfig LED_ADVANCED_SETTINGS
	bool "Advanced LED settings"
	default n

if LED_ADVANCED_SETTINGS

config LED_BRIGHTNESS
	int "LED brightness (0-100)"
	range 0 100
	default 100

config LED_FADE_DURATION_MS
	int "LED fade duration (ms)"
	range 0 5000
	default 500

menu "Expert settings"
	visible if LED_ADVANCED_SETTINGS

config LED_DEBUGGING
	bool "Enable LED debugging"
	default n

config LED_CUSTOM_BLINK_PATTERN
	bool "Custom blink pattern"
	default n

endmenu

endif

endif

rsource "modules/led_sensor_module/Kconfig"
source "Kconfig.zephyr"